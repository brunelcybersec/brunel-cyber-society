# Security headers for Apache (needs mod_headers and mod_rewrite).
# Only relevant if the site is ever served from an Apache host; GitHub
# Pages ignores .htaccess. See deploy/security-headers/README.md.

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Redirect all HTTP to HTTPS before anything else (HSTS is ignored over HTTP)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://substackcdn.com; media-src 'self'; connect-src 'self'; frame-src https://calendar.google.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header unset X-Powered-By

  <Files "events.ics">
    Header always set Cross-Origin-Resource-Policy "cross-origin"
  </Files>
</IfModule>

AddType text/calendar .ics
